# ── Kalpixk Frontend Config ───────────────────────────────────────────────────
# Copiar a .env.local para desarrollo local

# URL del backend FastAPI (sin trailing slash)
VITE_API_URL=http://localhost:8000

# URL WebSocket del backend (ws:// en dev, wss:// en prod)
VITE_WS_URL=ws://localhost:8000

# API Key (dejar vacío en dev si el backend no tiene AUTH activado)
VITE_API_KEY=
