package kalpixk:core;

interface kalpixkmonitor {
    record wasmevent {
        instructioncount: u64,
        memorypages: u32,
        fuelconsumed: u64,
        walltimens: u64,
        entropy: f32,
        calldepth: u32,
        importcalls: u32,
        exportcalls: u32,
    }
    extractfeatures: func(event: wasmevent) -> list<f32>;
}

world kalpixkcore {
    export kalpixkmonitor;
}
