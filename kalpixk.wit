package kalpixk:core;

world kalpixkcore {
    export extractfeatures: func(
        instructioncount: f64,
        memorypages: f64,
        fuelconsumed: f64,
        walltimens: f64,
        entropy: f64,
        calldepth: f64,
        importcalls: f64,
        exportcalls: f64
    ) -> list<f32>;
}
