package kalpixkcore:kalpixkcore;

world kalpixkcore {
    record wasmevent {
        instructioncount: u64,
        memorypages: u32,
        fuelconsumed: u64,
        walltimens: u64,
        entropy: f32,
        calldepth: u32,
        importcalls: u32,
        exportcalls: u32,
    }
    export extractfeatures: func(event: wasmevent) -> list<f32>;
}
