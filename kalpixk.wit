package kalpixk:core;

interface monitor {
    record event {
        instructions: u64,
        pages: u32,
        fuel: u64,
        time: u64,
        entropy: f32,
        depth: u32,
        imports: u32,
        exports: u32,
    }
    extractfeatures: func(e: event) -> list<f32>;
}

world core {
    export monitor;
}
